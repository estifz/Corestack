{
    "name": "Corestack",
    "version": "1.0.0",
    "description": "",
    "main": "server.js",
    "scripts": {
        "dev": "nodemon --exec tsx ./src/server.ts",
        "build": "tsc",
        "start": "node ./dist/server.js",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "prepare": "husky",
        "migration:show": "pnpm exec prisma migration show",
        "contract:emit": "prisma contract emit",
        "migration:plan": "pnpm exec prisma migration plan --name",
        "migration:apply": "pnpm exec prisma db migrate --advance-ref db",
        "migration:status": "pnpm exec prisma migration status"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "^11.15.1",
            "onFail": "download"
        }
    },
    "type": "module",
    "lint-staged": {
        "*.{ts,js}": [
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@prisma/orm-postgres": "8.0.0-rc.14",
        "@types/cors": "^2.8.19",
        "argon2": "^0.45.1",
        "compression": "^1.8.1",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "jose": "^6.2.12",
        "morgan": "^1.11.0",
        "pino": "^10.3.1",
        "temporal-polyfill": "^1.0.5",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@prisma/cli-engine": "0.6.2",
        "@types/compression": "^1.8.1",
        "@types/express": "^5.0.6",
        "@types/morgan": "^1.9.10",
        "@types/node": "^26.1.1",
        "dotenv": "^17.4.2",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "nodemon": "^3.1.14",
        "pino-pretty": "^13.1.3",
        "prettier": "3.9.6",
        "prisma": "8.0.0-rc.20",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    }
}
