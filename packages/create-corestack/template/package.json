{
    "name": "Corestack",
    "version": "1.0.0",
    "description": "",
    "main": "server.js",
    "scripts": {
        "dev": "nodemon --exec tsx ./src/server.ts",
        "build": "tsc",
        "test": "vitest run",
        "test:watch": "vitest",
        "start": "node ./dist/server.js",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "postinstall": "prisma generate --no-hints",
        "db:generate": "prisma generate --no-hints",
        "migration:dev": "prisma migrate dev",
        "migration:deploy": "prisma migrate deploy",
        "migration:status": "prisma migrate status",
        "docker:db:postgres": "docker compose up -d postgres",
        "docker:db:mongo": "docker compose up -d mongodb mongo-express",
        "docker:db:all": "docker compose up -d postgres mongodb mongo-express",
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "lint-staged": {
        "*.{ts,js}": [
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "@scalar/express-api-reference": "^0.10.30",
        "argon2": "^0.45.1",
        "compression": "^1.8.1",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "jose": "^6.2.12",
        "mongoose": "^8.12.0",
        "morgan": "^1.11.0",
        "pg": "^8.13.3",
        "pino": "^10.3.1",
        "resend": "^6.34.1",
        "temporal-polyfill": "^1.0.5",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@prisma/config": "^7.10.1",
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/morgan": "^1.9.10",
        "@types/node": "^26.1.1",
        "@types/pg": "^8.11.11",
        "@types/supertest": "^7.2.1",
        "dotenv": "^17.4.2",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "nodemon": "^3.1.14",
        "pino-pretty": "^13.1.3",
        "prettier": "3.9.6",
        "prisma": "^7.10.1",
        "supertest": "^7.3.1",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2",
        "vitest": "5.0.3"
    }
}
