        "picocolors": "^1.1.1"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^26.1.1",
        "tsup": "^8.4.0",
        "typescript": "^5.8.2",
        "vitest": "^3.0.7"
    }
