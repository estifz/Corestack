{
    "name": "create-corestack",
    "version": "0.1.0",
    "description": "Scaffold a production-ready TypeScript backend powered by CoreStack",
    "main": "./dist/index.js",
    "type": "module",
    "bin": {
        "create-corestack": "./dist/index.js",
        "corestack": "./dist/index.js"
    },
    "files": [
        "dist",
        "template"
    ],
