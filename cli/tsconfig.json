{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "module": "preserve",
        "target": "esnext",
        "types": ["node"],
        "sourceMap": true,
        "strict": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "resolveJsonModule": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
