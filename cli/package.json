{
    "name": "create-corestack",
    "version": "1.0.0",
    "description": "Scaffold reusable Node.js backends with configurable databases, authentication, and more.",
    "type": "module",
    "bin": {
        "create-corestack": "./dist/index.js"
    },
    "main": "./dist/index.js",
    "files": [
        "dist",
        "template"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/estifz/Corestack.git",
        "directory": "cli"
    },
    "bugs": {
        "url": "https://github.com/estifz/Corestack/issues"
    },
    "homepage": "https://github.com/estifz/Corestack#readme",
    "author": "Estifanos <kingestiff@gmail.com>",
    "license": "MIT",
    "engines": {
        "node": ">=20.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "dev": "tsx src/index.ts",
        "bundle:template": "tsx scripts/bundle-template.ts",
        "build": "tsx scripts/bundle-template.ts && tsup",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "corestack",
        "backend",
        "nodejs",
        "typescript",
        "cli",
        "scaffolding",
        "project-generator",
        "starter-kit",
        "backend-template",
        "express",
        "prisma",
        "postgresql",
        "mongodb",
        "authentication"
    ],
    "dependencies": {
        "@clack/prompts": "^0.11.0",
        "commander": "^14.0.3",
        "execa": "^9.5.2",
        "picocolors": "^1.1.1"
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "tsup": "^8.5.1",
        "tsx": "^4.23.1",
        "typescript": "^5.8.2"
    }
}
